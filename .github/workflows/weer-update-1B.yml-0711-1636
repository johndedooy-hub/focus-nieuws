name: Create Omroep Brabant Forecast Fantastique MP3

on:
  workflow_dispatch:

concurrency:
  group: weer-update
  cancel-in-progress: false

jobs:
  process-audio:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Cache TTS models
        uses: actions/cache@v4
        with:
          path: |
            ~/.local/share/tts
            ~/.cache/tts
          key: tts-xtts-v2

      - name: Cache pip packages
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: pip-tts-v1

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies & FFmpeg
        run: |
          set -e
          python -m pip install --upgrade pip
          python -m pip install --default-timeout=60 torchcodec || python -m pip install --default-timeout=60 torchcodec
          python -m pip install --default-timeout=60 "transformers<4.40.0" "scipy<1.13.0" pydub mutagen requests python-dateutil TTS || python -m pip install --default-timeout=60 "transformers<4.40.0" "scipy<1.13.0" pydub mutagen requests python-dateutil TTS
          if ! command -v ffmpeg >/dev/null 2>&1; then
            sudo apt-get update
            sudo apt-get install -y ffmpeg
          fi

      - name: Run FAST pipeline
        env:
          DRIVE_TXT_URL: 'https://focusfantastique.nl/weer-update.txt'
          COVER_IMAGE: 'weer-update.jpg'
          XTTS_SPEED: '1.50'
          XDG_CACHE_HOME: '/home/runner/.cache'
          TORCH_HOME: '/home/runner/.cache/torch'
          TRANSFORMERS_CACHE: '/home/runner/.cache/huggingface'
        run: |
          set -e
          python3 - <<'EOF'
          import os
          import re
          import sys
          import math
          import html
          import requests
          from pydub import AudioSegment, effects
          from mutagen.id3 import ID3, TIT2, TALB, APIC, ID3NoHeaderError

          def exit_with(msg, code=1):
              print(msg)
              sys.exit(code)

          # --- DOWNLOAD TXT ---
          url = os.environ.get("DRIVE_TXT_URL")
          if not url:
              exit_with("DRIVE_TXT_URL is niet ingesteld.", 1)

          try:
              resp = requests.get(url, timeout=60)
              resp.raise_for_status()
              # Als de server geen charset meestuurt: lees als UTF-8 (en negeer BOM)
              if "charset" not in resp.headers.get("Content-Type", "").lower():
                  resp.encoding = "utf-8-sig"
              # FIX: HTML-codes zoals &#xA; omzetten naar echte tekens/enters
              txt_data = html.unescape(resp.text)
          except Exception as e:
              exit_with(f"Fout bij downloaden TXT: {e}", 1)

          txt_data = txt_data.strip()
          if not txt_data:
              exit_with("TXT bestand is leeg — workflow stopt netjes.", 0)

          # --- TEKST NORMALISEREN VOOR BETERE UITSPRAAK (weertekst) ---
          NUM_NL = ["nul", "een", "twee", "drie", "vier", "vijf", "zes",
                    "zeven", "acht", "negen", "tien", "elf", "twaalf"]

          def num_nl(n):
              n = int(n)
              return NUM_NL[n] if 0 <= n <= 12 else str(n)

          WINDRICHTING = {
              "NNO": "noordnoordoost", "ONO": "oostnoordoost",
              "OZO": "oostzuidoost", "ZZO": "zuidzuidoost",
              "ZZW": "zuidzuidwest", "WZW": "westzuidwest",
              "WNW": "westnoordwest", "NNW": "noordnoordwest",
              "NO": "noordoost", "ZO": "zuidoost",
              "ZW": "zuidwest", "NW": "noordwest",
          }

          def normalize_for_tts(t):
              # FIX: restjes HTML-codes en tags opruimen (dubbel unescape voor de zekerheid)
              t = html.unescape(html.unescape(t))
              t = re.sub(r"<[^>]+>", " ", t)
              t = t.replace("\u00a0", " ")

              # FIX: alinea-einde = korte pauze (punt), losse enters = spatie
              t = re.sub(r"([.!?])\s*\n{2,}", r"\1 ", t)
              t = re.sub(r"\n{2,}", ". ", t)
              t = re.sub(r"[ \t]*\n[ \t]*", " ", t)

              # 's avonds, 's ochtends, 's middags, 's nachts, 's morgens
              t = re.sub(r"(?i)['’‘`´]s[\s\u00a0]+(avonds|ochtends|morgens|middags|nachts)",
                         lambda m: "s" + m.group(1).lower(), t)

              # windkracht: "5 bft." / "4 tot 6 bft" / "4-6 bft"
              def bft(m):
                  a = num_nl(m.group(1))
                  if m.group(2):
                      return f"{a} tot {num_nl(m.group(2))} beaufort"
                  return f"{a} beaufort"
              t = re.sub(r"(?i)\b(\d{1,2})(?:\s*(?:tot|-|–|en)\s*(\d{1,2}))?\s*bft\b\.?",
                         bft, t)

              # windrichtingen (alleen hoofdletters, bijv. ZW, NNO)
              t = re.sub(r"\b(NNO|ONO|OZO|ZZO|ZZW|WZW|WNW|NNW|NO|ZO|ZW|NW)\b",
                         lambda m: WINDRICHTING[m.group(1)], t)

              # temperaturen: 12°C / 12 °C / 12° -> 12 graden
              t = re.sub(r"\s*°(?:\s*C\b)?", " graden", t)

              # negatieve getallen: -3 -> min 3 (niet bij bereiken zoals 4-6)
              t = re.sub(r"(^|\W)[-–−](\d)", r"\1min \2", t)

              # decimalen: 2,5 -> 2 komma 5
              t = re.sub(r"(\d),(\d)", r"\1 komma \2", t)

              # eenheden
              t = re.sub(r"(?i)\bkm\s*/\s*(?:u|h)\b", "kilometer per uur", t)
              t = re.sub(r"(?i)(\d)\s*mm\b", r"\1 millimeter", t)
              t = re.sub(r"(?i)(\d)\s*cm\b", r"\1 centimeter", t)
              t = re.sub(r"\s*%", " procent", t)

              # veelvoorkomende afkortingen
              t = re.sub(r"(?i)\bt/m\b", "tot en met", t)
              t = re.sub(r"(?i)\bca\.", "circa", t)
              t = re.sub(r"(?i)\bmax\.", "maximaal", t)
              # "min." alleen vervangen als er geen getal voor staat (anders zijn het minuten)
              t = re.sub(r"(?i)(\d ?)?\bmin\.",
                         lambda m: m.group(0) if m.group(1) else "minimaal", t)

              # dubbele spaties opruimen
              t = re.sub(r"[ \t]{2,}", " ", t)
              return t

          tts_txt = normalize_for_tts(txt_data)
          print("TTS-tekst na normalisatie:\n", tts_txt)

          # --- INTRO + TEKST + OUTRO (één plek voor beide varianten) ---
          def build_transcripts(body):
              focus = (
                  "Hallo, dit is de Focus Fantastiek Weer Update.\n"
                  + body
                  + "\n en tot zover de update. "
              )
              langstraat = (
                  "Dit is het Langstraat weer.\n"
                  + body
                  + "\nTot zover het Langstraat weer,"
              )
              return focus, langstraat

          # Originele tekst (voor de .txt bestanden)
          transcript_focus, transcript_langstraat = build_transcripts(txt_data)

          # Genormaliseerde tekst (voor de spraak)
          tts_focus, tts_langstraat = build_transcripts(tts_txt)

          # --- TXT OPSLAAN (originele tekst) ---
          try:
              with open("weer-update.txt", "w", encoding="utf-8") as f:
                  f.write(transcript_focus)
              with open("Langstraat-Weer.txt", "w", encoding="utf-8") as f:
                  f.write(transcript_langstraat)
          except Exception as e:
              exit_with(f"Fout bij opslaan txt bestanden: {e}", 1)

          # --- CPML TOS automatisch accepteren (non-interactive CI) ---
          try:
              from TTS.utils.manage import ModelManager

              def _skip_tos(self, output_path):
                  print("CPML TOS automatisch geaccepteerd (CI).")
                  return True

              ModelManager.ask_tos = _skip_tos
          except Exception as e:
              print("Waarschuwing: kon CPML TOS override niet instellen:", e)

          # --- MODEL VOORAF DOWNLOADEN (vermijdt runtime prompts en partial loads) ---
          model_name = "tts_models/multilingual/multi-dataset/xtts_v2"
          model_path = None

          try:
              manager = ModelManager()
              print("Start model download via ModelManager:", model_name)
              model_path, config_path, model_item = manager.download_model(model_name)
              print("Model gedownload naar:", model_path)
          except Exception as e:
              exit_with(f"Fout bij downloaden XTTS model via ModelManager: {e}", 1)

          # --- SAFE GLOBALS VOOR TORCH LOAD (voorkomt Unsupported global errors) ---
          try:
              import torch
              from TTS.tts.configs.xtts_config import XttsConfig
              from TTS.tts.models.xtts import XttsAudioConfig, XttsArgs
              from TTS.config.shared_configs import BaseDatasetConfig

              # Allowlist de benodigde classes voor torch.load
              torch.serialization.add_safe_globals([
                  XttsConfig,
                  XttsAudioConfig,
                  XttsArgs,
                  BaseDatasetConfig
              ])
              print("Torch safe globals toegevoegd.")
          except Exception as e:
              print("Waarschuwing: kon torch safe globals niet instellen:", e)

          # --- XTTS INITIALISATIE (gebruik lokaal model pad) ---
          try:
              from TTS.api import TTS
          except Exception as e:
              exit_with(f"Fout bij import TTS.api: {e}", 1)

          try:
              tts_source = model_path if model_path else model_name
              tts = TTS(tts_source)
          except Exception as e:
              exit_with(f"Fout bij laden XTTS model in TTS: {e}", 1)

          # --- PREPARE SPEAKER WAV (fallback als niet aanwezig) ---
          speaker_src = "stem_voorbeeld.mp3"

          if not os.path.exists(speaker_src):
              print("stem_voorbeeld.mp3 niet gevonden; maak fallback clean_speaker.wav (stil).")
              silent = AudioSegment.silent(duration=1000)
              silent.export("clean_speaker.wav", format="wav")
          else:
              try:
                  speaker = AudioSegment.from_file(speaker_src)
                  speaker = effects.normalize(speaker)
                  speaker = speaker.low_pass_filter(9000)
                  speaker = speaker.high_pass_filter(100)
                  speaker.export("clean_speaker.wav", format="wav")
              except Exception as e:
                  exit_with(f"Fout bij verwerken stem_voorbeeld.mp3: {e}", 1)

          # --- RUN TTS ---
          try:
              speed = float(os.environ.get("XTTS_SPEED", "1.50"))
          except Exception:
              speed = 1.50

          # 1. Focus Update
          try:
              tts.tts_to_file(
                  text=tts_focus,
                  speaker_wav="clean_speaker.wav",
                  language="nl",
                  file_path="raw.wav",
                  speed=speed
              )
          except Exception as e:
              exit_with(f"Fout tijdens TTS generatie Focus: {e}", 1)

          # 2. Langstraat Update
          try:
              tts.tts_to_file(
                  text=tts_langstraat,
                  speaker_wav="clean_speaker.wav",
                  language="nl",
                  file_path="raw_langstraat.wav",
                  speed=speed
              )
          except Exception as e:
              exit_with(f"Fout tijdens TTS generatie Langstraat: {e}", 1)


          # --- LAAD EN NORMALISEER OUTPUT FOCUS ---
          if not os.path.exists("raw.wav"):
              exit_with("raw.wav niet aangemaakt door TTS.", 1)

          try:
              voice = AudioSegment.from_file("raw.wav")
              voice = effects.normalize(voice)
          except Exception as e:
              exit_with(f"Fout bij laden raw.wav: {e}", 1)

          # --- NEWSBED OVERLAY FOCUS ---
          final = voice

          if os.path.exists("weer-update-bed.mp3"):
              try:
                  bed = AudioSegment.from_file("weer-update-bed.mp3") - 20

                  if len(bed) < len(voice) and len(bed) > 0:
                      repeat = math.ceil(len(voice) / len(bed))
                      bed = bed * repeat

                  bed = bed[:len(voice)]
                  final = bed.overlay(voice)
              except Exception as e:
                  print("Waarschuwing: weer-update-bed overlay faalde:", e)
                  final = voice

          # --- EXPORT MP3 FOCUS ---
          try:
              final.export("weer-update.mp3", format="mp3", bitrate="128k")
          except Exception as e:
              exit_with(f"Fout bij export weer-update.mp3: {e}", 1)

          # --- ID3 TAGS FOCUS ---
          try:
              try:
                  id3 = ID3("weer-update.mp3")
              except ID3NoHeaderError:
                  id3 = ID3()

              id3.add(TIT2(encoding=3, text="Weer Update"))
              id3.add(TALB(encoding=3, text="Weer Update"))

              cover = os.environ.get("COVER_IMAGE", "weer-update.jpg")

              if os.path.exists(cover):
                  with open(cover, "rb") as img:
                      id3.add(
                          APIC(
                              encoding=3,
                              mime="image/jpeg",
                              type=3,
                              desc="Cover",
                              data=img.read()
                          )
                      )

              id3.save("weer-update.mp3")
          except Exception as e:
              print("Waarschuwing: ID3 taggen Focus faalde:", e)


          # --- LAAD EN NORMALISEER OUTPUT LANGSTRAAT ---
          if not os.path.exists("raw_langstraat.wav"):
              exit_with("raw_langstraat.wav niet aangemaakt door TTS.", 1)

          try:
              voice_langstraat = AudioSegment.from_file("raw_langstraat.wav")
              final_langstraat = effects.normalize(voice_langstraat)
          except Exception as e:
              exit_with(f"Fout bij laden raw_langstraat.wav: {e}", 1)

          # Let op: Langstraat krijgt puur de eigen stem, geen bed overlay i.v.m. kruisbesmetting.

          # --- EXPORT MP3 LANGSTRAAT ---
          try:
              final_langstraat.export("Langstraat-Weer.mp3", format="mp3", bitrate="128k")
          except Exception as e:
              exit_with(f"Fout bij export Langstraat-Weer.mp3: {e}", 1)

          # --- ID3 TAGS LANGSTRAAT ---
          try:
              try:
                  id3_langstraat = ID3("Langstraat-Weer.mp3")
              except ID3NoHeaderError:
                  id3_langstraat = ID3()

              id3_langstraat.add(TIT2(encoding=3, text="Langstraat Weer"))
              id3_langstraat.add(TALB(encoding=3, text="Langstraat Weer [by jdd]"))

              cover_langstraat = "Langstraat-Weer.jpg"

              if os.path.exists(cover_langstraat):
                  with open(cover_langstraat, "rb") as img:
                      id3_langstraat.add(
                          APIC(
                              encoding=3,
                              mime="image/jpeg",
                              type=3,
                              desc="Cover",
                              data=img.read()
                          )
                      )

              id3_langstraat.save("Langstraat-Weer.mp3")
          except Exception as e:
              print("Waarschuwing: ID3 taggen Langstraat faalde:", e)


          print("Pipeline voltooid: bestanden voor Focus en Langstraat aangemaakt.")
          EOF

      - name: Commit and push changes
        run: |
          set -e

          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"

          # Voeg nu alle 4 de bestanden toe
          git add weer-update.mp3 weer-update.txt Langstraat-Weer.mp3 Langstraat-Weer.txt

          if git diff --cached --quiet; then
            echo "Geen wijzigingen om te committen."
            exit 0
          fi

          git commit -m "FAST Update: Weer Updates (Focus + Langstraat) - UTC+2 $(date '+%H:%M')"

          git fetch origin main
          git rebase origin/main

          git push origin HEAD:main
